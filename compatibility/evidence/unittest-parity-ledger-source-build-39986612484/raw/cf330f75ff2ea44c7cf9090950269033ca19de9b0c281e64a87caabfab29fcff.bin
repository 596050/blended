name: Build pinned Blender browser source development artifact

on:
  push:
    branches: ['parity/**']
    paths:
      - tools/rebuild_browser_port.py
      - tools/prepare_browser_sqlite.py
      - tools/verify_browser_dependency_cache.py
      - tools/browser_package_overlay.py
      - .github/workflows/browser-source-build.yml
      - patches/browser-numerics/manifest.json
      - patches/browser-numerics/*.patch
      - patches/browser-sqlite/**
      - patches/browser-codecs/**
      - compatibility/package-overlays/**
      - compatibility/build-caches/**
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: browser-source-build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  source-development:
    name: Preserve features and build OFF-mode from pinned source
    runs-on: ubuntu-24.04
    timeout-minutes: 350
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13.13'
      - name: Install host build prerequisites
        run: |
          mkdir -p evidence/browser-source-build
          python3 - <<'PY'
          import datetime, json, platform
          from pathlib import Path
          Path('evidence/browser-source-build/host-bootstrap.json').write_text(json.dumps({
              'status': 'started', 'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
              'runner': platform.platform(), 'python': platform.python_version(),
              'scope': 'Host prerequisites only; no engine build claimed.'
          }, indent=2) + '\n')
          PY
          sudo apt-get update
          sudo apt-get install --yes --no-install-recommends \
            build-essential git git-lfs curl ca-certificates xz-utils unzip zip patch \
            ccache pkg-config perl autoconf automake libtool nasm yasm rsync \
            clang-17 lld-17 libegl-dev zlib1g-dev libzstd-dev libffi-dev libssl-dev
      - name: Restore the explicitly selected prior dependency and compiler cache
        id: cache
        uses: actions/cache/restore@v4
        with:
          path: |
            .cache/browser-source/gessa/lib/wasm
            .cache/browser-source/gessa/build-deps/_cache
            .cache/browser-source/gessa/tools/emsdk
            .cache/browser-source/gessa/build-dawn/dawn
            .cache/browser-source/ccache
            .cache/browser-source/emscripten-cache
          # A matching input hash does not establish installed output identity.
          # New candidates below are never selected automatically, even on reruns.
          key: blender-source-ubuntu24-x64-ebd6a49b6f17d26d0800c172eb40348041eb5fb37f5c7d4c67e5857f6dc8abd6-39841653080
      - name: Verify every restored dependency from the explicitly selected prior build
        id: cache_verify
        if: steps.cache.outputs.cache-matched-key != ''
        continue-on-error: true
        run: >-
          python3 tools/verify_browser_dependency_cache.py
          --cache-key '${{ steps.cache.outputs.cache-matched-key }}'
          --prefix .cache/browser-source/gessa/lib/wasm
          --manifest compatibility/build-caches/source-39841653080-harvest.jsonl
          --receipt evidence/browser-source-build/dependency-cache-reuse.json
      - name: Rebuild from source if prior dependency outputs cannot be verified
        if: steps.cache_verify.outcome == 'failure'
        run: |
          python3 - <<'PY'
          import shutil
          from pathlib import Path
          prefix = Path('.cache/browser-source/gessa/lib/wasm')
          if prefix.is_symlink():
              prefix.unlink()
          elif prefix.exists():
              shutil.rmtree(prefix)
          print('The prior cache failed identity verification; dependency recipes will rebuild the removed generated prefix.')
          PY
      - name: Reconstruct, build dependencies, compile, and package development engine
        run: >-
          python3 tools/rebuild_browser_port.py
          --work-dir .cache/browser-source
          --output evidence/browser-source-build
          --jobs 2
          --numeric-patchset patches/browser-numerics/manifest.json
          --sqlite-patchset patches/browser-sqlite/manifest.json
          --codec-patchset patches/browser-codecs/manifest.json
      - name: Restore the exact original Essentials brush resource
        run: |
          python3 - <<'PY'
          import datetime, hashlib, json, subprocess, sys
          from pathlib import Path
          root = Path.cwd()
          output = root / 'evidence/browser-source-build'
          source = root / '.cache/browser-source/gessa/upstream'
          record = {'schema': 1, 'kind': 'original-resource-package-preparation',
                    'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                    'status': 'running', 'tests_executed': 0, 'full_feature_parity': False,
                    'commands': []}
          receipt = output / 'essentials-preparation.json'
          commands = [
              ['git', '-C', str(source), '-c',
               'lfs.url=https://projects.blender.org/blender/blender.git/info/lfs',
               'lfs', 'pull', '--include=assets/brushes/essentials_brushes-mesh_sculpt.blend'],
              [sys.executable, 'tools/browser_package_overlay.py',
               '--base-archive', str(output / 'blender-source-development.tar.gz'),
               '--source-build-receipt', str(output / 'source-build.json'),
               '--asset-root', str(source), '--output', str(output / 'essentials')],
          ]
          try:
              for index, command in enumerate(commands):
                  row = {'argv': command, 'started_utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}
                  record['commands'].append(row)
                  receipt.write_text(json.dumps(record, indent=2) + '\n')
                  log = output / ('essentials-preparation-' + str(index) + '.log')
                  with log.open('wb') as stream:
                      result = subprocess.run(command, stdout=stream, stderr=subprocess.STDOUT, timeout=900)
                  row.update(returncode=result.returncode, log={'path': log.name, 'bytes': log.stat().st_size,
                             'sha256': hashlib.sha256(log.read_bytes()).hexdigest()})
                  if result.returncode:
                      raise RuntimeError('Original resource preparation failed: ' + str(command))
              record['status'] = 'assembled_and_verified'
          except BaseException as error:
              record.update(status='failed', reason=str(error))
              raise
          finally:
              record['finished_utc'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
              receipt.write_text(json.dumps(record, indent=2) + '\n')
          PY
      - name: Preserve a cache candidate requiring independent verification before reuse
        if: always()
        uses: actions/cache/save@v4
        with:
          path: |
            .cache/browser-source/gessa/lib/wasm
            .cache/browser-source/gessa/build-deps/_cache
            .cache/browser-source/gessa/tools/emsdk
            .cache/browser-source/gessa/build-dawn/dawn
            .cache/browser-source/ccache
            .cache/browser-source/emscripten-cache
          key: blender-source-ubuntu24-x64-${{ hashFiles('tools/rebuild_browser_port.py', 'tools/prepare_browser_sqlite.py', 'tools/verify_browser_dependency_cache.py', 'compatibility/build-caches/**', 'patches/browser-numerics/**', 'patches/browser-sqlite/**', 'patches/browser-codecs/**') }}-${{ github.run_id }}
      - name: Preserve source, toolchain, configuration, dependency and failure receipts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: browser-source-development-${{ github.run_id }}
          path: evidence/browser-source-build/
          compression-level: 1
          retention-days: 7
          if-no-files-found: warn

  qualify-development:
    name: Run frozen original invocations (${{ matrix.plan }})
    needs: source-development
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        include:
          - plan: main
            inventory: compatibility/evidence/unittest-native-5.2-2026-10-23/discovery-inventory.json
            inventory_sha256: 25bc5c5e790461d0c56b64e039fe1e4b1663e2ea120c7bbe8f1ec3efb627a0ef
          - plan: resources
            inventory: compatibility/evidence/unittest-native-resources-5.2-2026-10-23/resource-retry-inventory.json
            inventory_sha256: 9bdd9f03d1910499eee59d7c010ebde7be076e98ba55626d427e2ac3b9462932
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - uses: actions/download-artifact@v4
        with:
          name: browser-source-development-${{ github.run_id }}
          path: source-build
      - name: Install browser automation
        run: python3 -m pip install playwright==1.57.0
      - name: Identify the actual Chrome binary
        id: browser
        run: |
          python3 - <<'PY'
          import os
          from pathlib import Path
          executable = Path('/opt/google/chrome/chrome')
          if not executable.is_file() or executable.is_symlink():
              raise RuntimeError('The expected actual Chrome executable is unavailable; no browser test result can be inferred.')
          with open(os.environ['GITHUB_OUTPUT'], 'a') as stream:
              stream.write('executable=' + str(executable) + '\n')
          PY
      - name: Require artifact identity and every selected original assertion
        run: >-
          python3 tools/run_unittest_browser_matrix.py
          --native-inventory ${{ matrix.inventory }}
          --native-inventory-sha256 ${{ matrix.inventory_sha256 }}
          --repo-root .
          --source-build-receipt source-build/source-build.json
          --asset source-build/essentials/blender-source-development-essentials.tar.gz
          --package-overlay-receipt source-build/essentials/package-overlay.json
          --package-base-asset source-build/blender-source-development.tar.gz
          --browser-executable ${{ steps.browser.outputs.executable }}
          --output evidence/source-development-qualification-${{ matrix.plan }}
          --jobs 1
          --timeout 240
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: source-development-qualification-${{ matrix.plan }}-${{ github.run_id }}
          path: evidence/source-development-qualification-${{ matrix.plan }}/
          retention-days: 14

  preserve-evidence:
    name: Keep small source-build and qualification receipts
    needs: [source-development, qualify-development]
    if: always() && github.event_name != 'pull_request'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    concurrency:
      group: browser-source-evidence
      cancel-in-progress: false
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          pattern: '*-${{ github.run_id }}'
          path: receipts
      - name: Select bounded receipts without binary build output
        env:
          RUN_ID: ${{ github.run_id }}
          SOURCE_SHA: ${{ github.sha }}
          SOURCE_JOB_RESULT: ${{ needs.source-development.result }}
          QUALIFICATION_JOB_RESULT: ${{ needs.qualify-development.result }}
        run: |
          python3 - <<'PY'
          import hashlib, json, os
          from pathlib import Path
          run = os.environ['RUN_ID']
          source = Path('receipts') / ('browser-source-development-' + run)
          selected = Path('selected')
          selected.mkdir()
          files = []
          def preserve(path, relative, limit=2 * 1024 * 1024):
              if not path.is_file() or path.is_symlink():
                  return
              data = path.read_bytes()
              original = {'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest()}
              truncated = len(data) > limit
              if truncated:
                  if path.suffix == '.json':
                      raise RuntimeError('JSON receipt exceeds the publication bound: ' + str(path))
                  data = data[:256 * 1024] + b'\n[LOG MIDDLE OMITTED; ORIGINAL REMAINS IN RUN ARTIFACT]\n' + data[-1536 * 1024:]
              destination = selected / relative
              destination.parent.mkdir(parents=True, exist_ok=True)
              destination.write_bytes(data)
              files.append({'path': relative, 'original': original, 'truncated': truncated,
                            'preserved_bytes': len(data), 'preserved_sha256': hashlib.sha256(data).hexdigest()})
          for name in ('source-build.json', 'host-bootstrap.json', 'blender-preload-lfs.json',
                       'dependency-cache-reuse.json',
                       'dependency-recipe-inputs.json', 'dependency-harvest.jsonl',
                       'CMakeCache.txt', 'openimageio-CMakeCache.txt',
                       'sqlite-patch-application.json', 'codec-patch-application.json',
                       'sqlite-sqlite-cache.json', 'python-sqlite-cache.json',
                       'essentials-preparation.json'):
              preserve(source / name, 'source/' + name)
          for name in ('package-overlay.json', 'overlay-manifest.json'):
              preserve(source / 'essentials' / name, 'source/essentials/' + name)
          build_receipt = source / 'source-build.json'
          if build_receipt.is_file():
              receipt = json.loads(build_receipt.read_text())
              for stage in receipt.get('stages', []):
                  if stage.get('status') in ('failed', 'blocked') and stage.get('log'):
                      name = Path(stage['log']).name
                      preserve(source / 'logs' / name, 'source/logs/' + name)
          for plan in ('main', 'resources'):
              qualification = Path('receipts') / ('source-development-qualification-' + plan + '-' + run)
              for name in ('matrix.json', 'harness-manifest.json', 'native-discovery-inventory.json'):
                  preserve(qualification / name, 'qualification/' + plan + '/' + name)
              for path in sorted(qualification.glob('*/qualification.json')):
                  preserve(path, 'qualification/' + plan + '/' + path.parent.name + '/' + path.name)
              for path in sorted(qualification.glob('*/host-process.json')):
                  preserve(path, 'qualification/' + plan + '/' + path.parent.name + '/' + path.name)
          if not files:
              raise RuntimeError('No build or qualification receipts were produced; no success can be inferred.')
          (selected / 'publication.json').write_text(json.dumps({
              'schema': 1, 'source_sha': os.environ['SOURCE_SHA'], 'run_id': run,
              'source_job_result': os.environ['SOURCE_JOB_RESULT'],
              'qualification_job_result': os.environ['QUALIFICATION_JOB_RESULT'],
              'deployed': False, 'full_feature_parity': False, 'files': files,
              'scope': 'Small durable receipts only. Full logs and binaries remain run artifacts.'
          }, indent=2) + '\n')
          PY
      - name: Append receipts to the separate evidence branch
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          SOURCE_SHA: ${{ github.sha }}
          RUN_ID: ${{ github.run_id }}
        run: |
          git init --initial-branch=browser-source-evidence published
          git -C published remote add origin "https://github.com/${REPO}.git"
          gh auth setup-git
          if git -C published ls-remote --exit-code --heads origin browser-source-evidence >/dev/null 2>&1; then
            git -C published fetch --depth=1 origin browser-source-evidence
            git -C published reset --hard FETCH_HEAD
          fi
          DESTINATION="published/${SOURCE_SHA}/${RUN_ID}"
          mkdir -p "$DESTINATION"
          cp -a selected/. "$DESTINATION/"
          git -C published add -A
          if ! git -C published diff --cached --quiet; then
            git -C published -c user.name=github-actions[bot] -c user.email=41898282+github-actions[bot]@users.noreply.github.com commit -m "Preserve source-build evidence ${RUN_ID} at ${SOURCE_SHA}"
            git -C published push origin HEAD:refs/heads/browser-source-evidence
          fi
