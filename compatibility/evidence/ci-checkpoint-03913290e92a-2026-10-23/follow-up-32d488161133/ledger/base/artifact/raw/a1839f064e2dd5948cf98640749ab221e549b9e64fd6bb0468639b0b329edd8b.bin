--- a/intern/eigen/CMakeLists.txt
+++ b/intern/eigen/CMakeLists.txt
@@ -28,3 +28,13 @@
 )
 
 blender_add_lib(bf_intern_eigen "${SRC}" "${INC}" "${INC_SYS}" "${LIB}")
+
+# Match the existing Eigen 4x4 inverse kernel used by the official Linux x64
+# x86-64-v2 reference. The public wrapper passes float arrays, not Eigen types.
+# Keep ISA selection local to the inverse translation unit.
+if(EMSCRIPTEN)
+  set_property(SOURCE intern/matrix.cc APPEND PROPERTY COMPILE_OPTIONS
+    -msimd128 -msse2
+  )
+  target_link_options(bf_intern_eigen INTERFACE -msimd128)
+endif()
