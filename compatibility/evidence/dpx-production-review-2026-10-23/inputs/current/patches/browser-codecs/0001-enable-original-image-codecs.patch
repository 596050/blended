+expected = {"USE_WEBP": "ON", "USE_OPENJPEG": "ON", "USE_LIBHEIF": "ON", "EMBEDPLUGINS": "ON", "BUILD_SHARED_LIBS": "OFF"}
+for key, value in expected.items():
+    if values.get(key) != value:
+        raise SystemExit(f"Required OIIO configuration missing: {key}={value}")
+PY
+mkdir -p "$PREFIX/share/blended"
+install -m644 "$BUILD/CMakeCache.txt" "$PREFIX/share/blended/openimageio-codecs-CMakeCache.txt"
 
 rm -rf "$SCRATCH"
 echo "openimageio ${OIIO_VERSION}: installed to $PREFIX (config: lib/cmake/OpenImageIO)"
