+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Original Blender 5.2 libaom 3.13.1 and the exact upstream Blender patch.
+set -euo pipefail
+source "$(dirname "$0")/codec-common.sh"
+bc_prepare aom libaom-3.13.1.tar.gz \
+  https://storage.googleapis.com/aom-releases/libaom-3.13.1.tar.gz \
+  19e45a5a7192d690565229983dad900e76b513a02306c12053fb9a262cbeca7d \
+  libaom-3.13.1
+
+BC_AOM_PATCH="$BC_ROOT/upstream/build_files/build_environment/patches/aom_6d2b7f71b98bfa28e372b1f2d85f137280bdb3de.diff"
+bc_check_sha256 "$BC_AOM_PATCH" 5cb6ce17857a5283521d507dd834e6a45f8749468eeea1d2a9fd5f2e3e7544ea
+patch --batch --fuzz=0 -p1 -d "$BC_SOURCE" < "$BC_AOM_PATCH"
+
+# AOM's generic C backend avoids native assembly and CPU probing. Encoding,
+# decoding, high bit depth and pthread support retain their upstream settings.
+# A static archive is required by this Emscripten link profile.
+bc_configure \
+  -DAOM_TARGET_CPU=generic \
+  -DCONFIG_AV1_ENCODER=1 \
+  -DCONFIG_AV1_DECODER=1 \
+  -DCONFIG_AV1_HIGHBITDEPTH=1 \
+  -DCONFIG_MULTITHREAD=1 \
+  -DENABLE_TESTDATA=OFF \
+  -DENABLE_TESTS=OFF \
+  -DENABLE_TOOLS=OFF \
+  -DENABLE_EXAMPLES=OFF \
+  -DENABLE_DOCS=OFF
+bc_install lib/libaom.a include/aom/aom_encoder.h include/aom/aom_decoder.h
diff --git a/scripts/deps/codec-common.sh b/scripts/deps/codec-common.sh
new file mode 100644
--- /dev/null
+++ b/scripts/deps/codec-common.sh
@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Shared setup for the optional original Blender 5.2 codec dependencies.
+# Recipes are installed in the pinned port's scripts/deps directory.
+
+bc_check_sha256() {
+  python3 - "$1" "$2" <<'PY'
+import hashlib
+from pathlib import Path
+import sys
+p = Path(sys.argv[1])
+h = hashlib.sha256(p.read_bytes()).hexdigest()
+if h != sys.argv[2]:
+    raise SystemExit(f"SHA256 mismatch for {p}: {h}")
+PY
+}
+
+bc_prepare() {
+  BC_NAME="$1"
+  BC_FILENAME="$2"
+  BC_URL="$3"
+  BC_SHA256="$4"
+  BC_TOPDIR="$5"
+  BC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+  BC_PREFIX="$BC_ROOT/lib/wasm"
+  BC_SCRATCH="$BC_ROOT/build-deps/$BC_NAME"
+  BC_CACHE="$BC_ROOT/build-deps/_cache"
+  BC_JOBS="${BLENDED_BUILD_JOBS:-1}"
+  case "$BC_JOBS" in 1|2|3|4) ;; *) echo "codec builds require 1 to 4 jobs" >&2; exit 2 ;; esac
+  : "${EM_CACHE:?Set EM_CACHE to a build-specific directory before running codec recipes}"
+  BC_EM_CACHE="$EM_CACHE"
+
+  # shellcheck disable=SC1091
+  source "$BC_ROOT/tools/emsdk/emsdk_env.sh"
+  # emsdk_env.sh assigns its own cache. Restore the selected isolated cache.
+  export EM_CACHE="$BC_EM_CACHE"
+  mkdir -p "$BC_CACHE" "$BC_PREFIX"
+  BC_TARBALL="$BC_CACHE/$BC_FILENAME"
+  if [ ! -f "$BC_TARBALL" ]; then
+    curl -fL --retry 3 -o "$BC_TARBALL" "$BC_URL"
+  fi
+  bc_check_sha256 "$BC_TARBALL" "$BC_SHA256"
+
+  # Reconfigure each recipe from verified source. An old archive or CMake
+  # marker must not silently qualify a different codec feature profile.
+  rm -rf "$BC_SCRATCH"
+  mkdir -p "$BC_SCRATCH"
+  python3 - "$BC_TARBALL" "$BC_SCRATCH" "$BC_TOPDIR" <<'PY'
+from pathlib import Path, PurePosixPath
+import sys
+import tarfile
+archive, scratch, expected_root = sys.argv[1:]
+with tarfile.open(archive) as source:
+    for member in source.getmembers():
+        path = PurePosixPath(member.name)
+        if path.is_absolute() or ".." in path.parts or not path.parts or path.parts[0] != expected_root:
+            raise SystemExit(f"Unexpected archive path: {member.name}")
+    source.extractall(scratch, filter="data")
+assert (Path(scratch) / expected_root / "CMakeLists.txt").is_file()
+PY
+  BC_SOURCE="$BC_SCRATCH/$BC_TOPDIR"
+  BC_BUILD="$BC_SCRATCH/build"
+}
+
+bc_configure() {
+  emcmake cmake -S "$BC_SOURCE" -B "$BC_BUILD" -G "Unix Makefiles" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+    -DCMAKE_INSTALL_PREFIX="$BC_PREFIX" \
+    -DCMAKE_INSTALL_LIBDIR=lib \
+    -DCMAKE_PREFIX_PATH="$BC_PREFIX" \
+    -DBUILD_SHARED_LIBS=OFF \
+    -DCMAKE_C_FLAGS="-pthread -fexceptions" \
+    -DCMAKE_CXX_FLAGS="-pthread -fexceptions" \
+    "$@"
+}
+
+bc_install() {
+  emmake cmake --build "$BC_BUILD" --target install --parallel "$BC_JOBS"
+  local artifact
+  for artifact in "$@"; do
+    test -s "$BC_PREFIX/$artifact" || { echo "missing codec artifact: $artifact" >&2; exit 1; }
+  done
+}
